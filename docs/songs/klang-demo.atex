// Klang-Demo: stellt die Band-Klänge nacheinander vor (je 2 Takte), am Ende alle zusammen.
// Erzeugt mit werkzeuge/klang-demo.py. Instrumente und Bänke: ALPHATEX.md, Abschnitt 2.
// Tipp: Mehrere Klänge derselben Bank teilen sich eine Spur und wechseln mit {instrument …}.

\title "Klang-Demo"
\subtitle "Band-Klänge von TheKellerkinder"
\tempo 100
.
