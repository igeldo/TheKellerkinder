// Syntax-Beispiele: alle Bausteine aus ALPHATEX.md in einem kurzen Stück
// (Eigenkomposition, frei verwendbar)

\title "Syntax-Beispiele"
\subtitle "Bausteine aus ALPHATEX.md"
\tempo 100
.

// ---------------------------------------------------------------- Gitarre
\track "E-Gitarre"
  \staff {score tabs}               // Noten UND Tabulatur
  \instrument distortionguitar
  \tuning (E4 B3 G3 D3 A2 E2)

  // Takt 1–2: Intro mit Palm Mute und Powerchords, zweimal gespielt
  \section "Intro"
  \ro
  :8 0.6{pm} 0.6{pm} 0.6{pm} 0.6{pm} (0.6 2.5 2.4) (0.6 2.5 2.4) (3.6 5.5 5.4) (5.6 7.5 7.4) |
  \rc 2
  :8 0.6{pm} 0.6{pm} 0.6{pm} 0.6{pm} :4 (7.6 9.5 9.4){ch "B5"} (5.6 7.5 7.4){ch "A5"} |

  // Takt 3: Hammer-on, Dead Note, Slide
  \section "Strophe"
  :8 5.3{h} 7.3 5.3 0.6{x} :4 7.3{sl} 9.3 |

  // Takt 4: Bending mit Vibrato, Akkord mit Namen, Pause
  :2 7.3{b (0 4) v} :4 (0.6 2.5 2.4){ch "E5"} r |

// ---------------------------------------------------------------- Bass
\track "Bass"
  \staff {tabs}
  \instrument electricbassfinger
  \tuning (G2 D2 A1 E1)

  :8 0.4 0.4 0.4 0.4 0.4 0.4 3.4 5.4 |
  :8 0.4 0.4 0.4 0.4 :4 7.4 5.4 |
  :4 0.4 0.4 5.4 5.4 |
  :2 7.4 :4 0.4 r |

// ---------------------------------------------------------------- Schlagzeug
\track "Schlagzeug"
  \instrument percussion
  \clef neutral
  // 36 Bassdrum, 38 Snare, 42 Hi-Hat geschlossen, 49 Crash
  :8 (36 42) (42) (38 42) (42) (36 42) (36 42) (38 42) (42) |
  :8 (36 42) (42) (38 42) (42) (36 42) (36 42) (38 42) (42) |
  :8 (36 42) (42) (38 42) (42) (36 42) (36 42) (38 42) (42) |
  :4 (36 49) (38) (36) (38) |
